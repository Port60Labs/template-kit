{
  "description": "The CSS custom-property contract, the theming tokens the platform base declares and every island/page consumes. A template overrides them via :root:root in its theme.css. Additive-only: tokens are never removed or repurposed within a contract major.",
  "tokens": [
    { "name": "--bg", "description": "Page background." },
    { "name": "--bg-tint", "description": "Subtle tinted background (footer, wells)." },
    { "name": "--surface", "description": "Card/panel surface." },
    { "name": "--ink", "description": "Primary text colour." },
    { "name": "--muted", "description": "Secondary text colour." },
    { "name": "--primary", "description": "Brand primary (progress, links, selected states)." },
    { "name": "--primary-strong", "description": "Darker primary (hover/emphasis)." },
    { "name": "--primary-soft", "description": "Translucent primary wash (selected fills, chips)." },
    { "name": "--accent", "description": "Action accent (the donate CTA family)." },
    { "name": "--accent-strong", "description": "Darker accent." },
    { "name": "--gold", "description": "Highlight tint (marks, ratings)." },
    { "name": "--line", "description": "Hairline borders." },
    { "name": "--line-strong", "description": "Emphasised borders (selected, focus)." },
    { "name": "--danger", "description": "Errors and destructive affordances." },
    { "name": "--cta-hover", "description": "The donate-button hover 'go' colour." },
    { "name": "--cta-hover-strong", "description": "Darker CTA hover." },
    { "name": "--shadow-sm", "description": "Small elevation shadow." },
    { "name": "--shadow", "description": "Large elevation shadow." },
    { "name": "--radius", "description": "Large corner radius (cards, bands)." },
    { "name": "--radius-sm", "description": "Small corner radius (inputs, chips)." },
    { "name": "--container", "description": "Max content width." }
  ]
}
